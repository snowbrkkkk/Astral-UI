local function FadeOutGui(rootFrame, duration, onDone)
    local scale = rootFrame:FindFirstChild("UIScale")
    if not scale then scale = Instance.new("UIScale", rootFrame) end
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(scale, tweenInfo, {Scale = 0.8}):Play() 
    if rootFrame:IsA("CanvasGroup") then
        TweenService:Create(rootFrame, tweenInfo, {GroupTransparency = 1}):Play()
    end
    task.delay(duration, function() if onDone then onDone() end end)
end

-- [[ LÓGICA DE VALIDAÇÃO ]] --
local function validateKey(userKey)
    local ok, validation = pcall(function() return Junkie.check_key(userKey) end)
    
    if not ok then return false, "error" end
    
    if validation then
        if validation.success or validation.valid then
            getgenv().SCRIPT_KEY = userKey
            return true, "valid"
        else
            local msg = (validation.message or ""):lower()
            if string.find(msg, "banned") or string.find(msg, "blacklisted") or string.find(msg, "hwid") then
                return false, "banned"
            end
        end
    end
    return false, "invalid"
end

local function trySavedKey()
    local keys = readKeys()
    if #keys == 0 then return false, nil end
    for _, key in ipairs(keys) do 
        local success, _ = validateKey(key)
        if success then return true, key end 
    end
    return false, nil
end

local function RunSuccessCallback()
    local cb = AstralLib.Config.Callback
    if type(cb) == "function" then
        cb()
    elseif type(cb) == "string" and cb ~= "" then
        loadstring(cb)()
    end
end

