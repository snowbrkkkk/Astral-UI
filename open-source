local function ApplyFontRecursive(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        obj.FontFace = JunkieFont
        if obj:IsA("TextLabel") or obj:IsA("TextBox") then
            obj.TextTruncate = Enum.TextTruncate.AtEnd
            obj.ClipsDescendants = true
        end
    end
    for _, v in ipairs(obj:GetChildren()) do
        ApplyFontRecursive(v)
    end
end

local function GetCustomAsset(url, fileName)
    local getAsset = getcustomasset or getsynasset
    if not getAsset or not writefile then return AstralLib.Config.Discord.DefaultIcon end

    local path = AstralLib.Config.FolderName .. "/" .. fileName
    if isfile(path) then return getAsset(path) end

    local success, response = pcall(function()
        return http_request({
            Url = url,
            Method = "GET",
            Headers = {["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}
        })
    end)

    if success and response.StatusCode == 200 and response.Body and #response.Body > 100 then
        writefile(path, response.Body)
        return getAsset(path)
    end
    
    return AstralLib.Config.Discord.DefaultIcon
end

local function GetDiscordInviteData(code)
    code = code:gsub("https://discord.gg/", ""):gsub("discord.gg/", "")
    local url = "https://discord.com/api/v10/invites/" .. code .. "?with_counts=true"
    local success, response = pcall(function() 
        return http_request({Url = url, Method = "GET"}) 
    end)
    if success and response.StatusCode == 200 then
        local decoded
        pcall(function() decoded = HttpService:JSONDecode(response.Body) end)
        return decoded
    end
    return nil
end

local function CreateIcon(iconName, size, parent, position, color)
    local targetColor = color or Color3.new(1, 1, 1)
    local icon = Icons.Image({
        Icon = iconName,
        Size = UDim2.fromOffset(size, size),
        Colors = { targetColor },
    })
    local frame = icon.IconFrame
    frame.BackgroundTransparency = 1 
    frame.BorderSizePixel = 0
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = position
    frame.Parent = parent
    local baseZ = (parent and parent.ZIndex or 1) + 1
    frame.ZIndex = baseZ
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then
            d.BackgroundTransparency = 1 
            d.ImageColor3 = targetColor 
            d.ZIndex = baseZ
        elseif d:IsA("Frame") then
            d.BackgroundTransparency = 1
        end
    end
    return frame
end

-- [[ SISTEMA DE ARQUIVOS ]] --
local function GetFilePaths()
    return {
        key = AstralLib.Config.FolderName .. "/keys.txt",
        time = AstralLib.Config.FolderName .. "/keys_time.txt",
        counter = AstralLib.Config.FolderName .. "/counter.txt"
    }
end

local function readKeys()
    local paths = GetFilePaths()
    local keys = {}
    if isfile and isfile(paths.key) then
        for line in readfile(paths.key):gmatch("[^\r\n]+") do
            if line ~= "" then table.insert(keys, line) end
        end
    end
    return keys
end

local function saveKeys(keysTable) 
    local paths = GetFilePaths()
    if writefile then writefile(paths.key, table.concat(keysTable, "\n")) end 
end

local function readLastKeyDate()
    local paths = GetFilePaths()
    if isfile and isfile(paths.time) then
        local ok, content = pcall(readfile, paths.time)
        if ok and content ~= "" then return content end
    end
    return nil
end

local function saveLastKeyDateOnce()
    if not isfile or not readfile or not writefile then return end
    local paths = GetFilePaths()
    local current = ""
    if isfile(paths.time) then
        local ok, content = pcall(readfile, paths.time)
        if ok then current = content or "" end
    end
    if current == "" then
        local dateStr = os.date("%d/%m/%Y")
        writefile(paths.time, dateStr)
    end
end

local function readCounter()
    local paths = GetFilePaths()
    if isfile and isfile(paths.counter) then
        local ok, content = pcall(readfile, paths.counter)
        if ok then local n = tonumber(content) if n then return n end end
    end
    return 0
end

local function saveCounter(n) 
    local paths = GetFilePaths()
    if writefile then writefile(paths.counter, tostring(n)) end 
end

