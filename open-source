-- [[ FUNÇÃO PRINCIPAL DE INICIALIZAÇÃO DA LIBRARY ]] --
function AstralLib:Init(userConfig)
    if getgenv().AstralKeySys then return end
    getgenv().AstralKeySys = true

    -- Mesclar configurações do usuário
    if userConfig then
        for k, v in pairs(userConfig) do
            if k == "Theme" then
                for tk, tv in pairs(v) do AstralLib.Theme[tk] = tv end
            elseif k == "Junkie" then
                 for jk, jv in pairs(v) do AstralLib.Config.Junkie[jk] = jv end
            else
                AstralLib.Config[k] = v
            end
        end
    end

    -- Configurar Junkie
    Junkie.service = AstralLib.Config.Junkie.Service
    Junkie.identifier = AstralLib.Config.Junkie.Identifier
    Junkie.provider = AstralLib.Config.Junkie.Provider

    -- Criar pasta
    if not isfolder(AstralLib.Config.FolderName) then makefolder(AstralLib.Config.FolderName) end
    local filePaths = GetFilePaths()
    if writefile and not isfile(filePaths.key) then writefile(filePaths.key, "") end
    if writefile and not isfile(filePaths.time) then writefile(filePaths.time, "") end
    if writefile and not isfile(filePaths.counter) then writefile(filePaths.counter, "0") end

    -- Iniciar fluxo
    local ok, savedKey = trySavedKey()
    if ok and savedKey then
        if AstralLib.Config.CheckKeyUI then
            ShowCheckUI() 
        else
            ShowNotification("valid")
            ShowNotification("loading")
            task.wait(1)
            RunSuccessCallback()
        end
    else
        CreateAstralKeyUI()
    end
end

return AstralLib
